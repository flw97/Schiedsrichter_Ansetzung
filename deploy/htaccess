# Document root of the vhost is the app folder. Every request is served from public/,
# so .env.production, storage/, vendor/ and the other app folders are never reachable.
# APP_ENV makes Laravel load .env.production (see LoadEnvironmentVariables).
SetEnv APP_ENV production

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
